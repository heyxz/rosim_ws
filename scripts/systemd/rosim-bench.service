# ROS 2 仿真服务端（headless）：机器人 + 控制器 + 规划 + WebSocket
# 手动：systemctl --user start|stop rosim-bench
[Unit]
Description=rosim 仿真服务端（:8765）
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/rosim_ws
Environment=HOME=%h
ExecStart=/bin/bash %h/rosim_ws/scripts/run-server.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
