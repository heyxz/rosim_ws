<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosim_rl</name>
  <version>0.1.0</version>
  <description>Reinforcement-learning extension for rosim: RlPlanner (MotionPlanner
    implementation, optionally backed by libtorch) and a Python gym environment
    skeleton over the rosim ROS2 interfaces.</description>
  <maintainer email="xz@todo.todo">xz</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rosim_planning</depend>
  <depend>rosim_interfaces</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>eigen3-cmake-module</depend>

  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
